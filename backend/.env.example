# Server
SERVER_PORT=2222

# MySQL
MYSQL_DSN=root:your_password@tcp(127.0.0.1:3306)/IMChat?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Tencent COS
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=your_bucket_name
COS_REGION=ap-shanghai

# JWT
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRE_HOURS=24

# CORS (comma-separated allowlist)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
